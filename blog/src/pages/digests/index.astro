---
import BaseLayout from '@layouts/BaseLayout.astro';
import CategoryIndex from '@components/CategoryIndex.astro';
import { getPostsByCategory } from '@utils/posts';

const posts = await getPostsByCategory('digests');
---

<BaseLayout title="Digests" description="Digests of AI articles, videos, and news">
  <CategoryIndex
    title="Digests"
    subtitle="Summary notes from reading AI articles, videos, and news"
    posts={posts}
  />
</BaseLayout>
