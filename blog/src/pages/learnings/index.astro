---
import BaseLayout from '@layouts/BaseLayout.astro';
import CategoryIndex from '@components/CategoryIndex.astro';
import { getPostsByCategory } from '@utils/posts';

const posts = await getPostsByCategory('learnings');
---

<BaseLayout title="Learnings" description="Hands-on records of learning AI tools and technologies">
  <CategoryIndex
    title="Learnings"
    subtitle="Hands-on records of learning AI tools and technologies"
    posts={posts}
  />
</BaseLayout>
